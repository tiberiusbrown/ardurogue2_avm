{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure ArduRogue 2",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build ArduRogue 2",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--config", "RelWithDebInfo",
                "--target", "ardurogue2"
            ],
            "dependsOn": "Configure ArduRogue 2",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
